{
  "schemas": {
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offerCode",
        "name",
        "minor"
      ],
      "properties": {
        "offerCode": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "selection",
        "quantity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "selection": {"$ref": "../schemas/ordering.json#/schemas/Selection"},
        "quantity": {
          "type": "integer"
        }
      }
    },
    "Order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "customerId",
        "editionId",
        "currency",
        "status",
        "lines"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "customerId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "editionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "currency": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "placed"
          ]
        },
        "lines": {
          "type": "array",
          "items": {"$ref": "../schemas/ordering.json#/schemas/Line"}
        }
      }
    },
    "CreateCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customerId",
        "editionId"
      ],
      "properties": {
        "customerId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "editionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "LineCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineId",
        "editionId",
        "offerCode",
        "quantity"
      ],
      "properties": {
        "lineId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "editionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "offerCode": {
          "type": "string"
        },
        "quantity": {
          "type": "integer"
        }
      }
    },
    "QuantityCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineId",
        "quantity"
      ],
      "properties": {
        "lineId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "quantity": {
          "type": "integer"
        }
      }
    }
  }
}
