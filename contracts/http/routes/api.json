{
  "health": {
    "get": {
      "operationId": "apiHealth",
      "security": [],
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "role"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "ok"
                    ]
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "client-api"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "diagnostics": {
    "get": {
      "operationId": "apiDiagnostics",
      "security": [
        {
          "CLIKey": []
        }
      ],
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {"$ref": "../schemas/diagnostics.json#/schemas/Session"}
            }
          }
        },
        "401": {"$ref": "../schemas/common.json#/responses/401"},
        "503": {"$ref": "../schemas/common.json#/responses/503"}
      }
    }
  },
  "login": {
    "post": {
      "operationId": "login",
      "security": [],
      "parameters": [
        {
          "name": "Origin",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "description": "Local operator access code; at most 4096 bytes.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "password"
              ],
              "properties": {
                "password": {
                  "type": "string"
                }
              }
            },
            "example": {
              "password": "code"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "authenticated"
                ],
                "properties": {
                  "authenticated": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                }
              }
            }
          },
          "headers": {
            "Set-Cookie": {
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "400": {"$ref": "../schemas/common.json#/responses/400"},
        "401": {"$ref": "../schemas/common.json#/responses/401"},
        "403": {"$ref": "../schemas/common.json#/responses/403"},
        "503": {"$ref": "../schemas/common.json#/responses/503"}
      }
    }
  },
  "session": {
    "get": {
      "operationId": "session",
      "security": [
        {
          "OperatorSession": []
        }
      ],
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "subject",
                  "name",
                  "role"
                ],
                "properties": {
                  "subject": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "operator"
                    ]
                  }
                }
              }
            }
          }
        },
        "401": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "authenticated"
                ],
                "properties": {
                  "authenticated": {
                    "type": "boolean",
                    "enum": [
                      false
                    ]
                  }
                }
              }
            }
          }
        },
        "503": {"$ref": "../schemas/common.json#/responses/503"}
      }
    }
  },
  "logout": {
    "post": {
      "operationId": "logout",
      "security": [],
      "parameters": [
        {
          "name": "Origin",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "authenticated"
                ],
                "properties": {
                  "authenticated": {
                    "type": "boolean",
                    "enum": [
                      false
                    ]
                  }
                }
              }
            }
          }
        },
        "403": {"$ref": "../schemas/common.json#/responses/403"},
        "503": {"$ref": "../schemas/common.json#/responses/503"}
      }
    }
  },
  "connect": {
    "post": {
      "operationId": "realtimeConnect",
      "security": [
        {
          "RealtimeProxy": []
        }
      ],
      "description": "Internal Centrifugo proxy. Cookie and Origin carry the original session authority. Subscription choices are selected by the server.",
      "requestBody": {
        "required": false,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "result"
                    ],
                    "properties": {
                      "result": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "user",
                          "subs",
                          "expire_at"
                        ],
                        "properties": {
                          "user": {
                            "type": "string"
                          },
                          "subs": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [],
                              "properties": {}
                            }
                          },
                          "expire_at": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "disconnect"
                    ],
                    "properties": {
                      "disconnect": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "code",
                          "reason"
                        ],
                        "properties": {
                          "code": {
                            "type": "integer"
                          },
                          "reason": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "403": {"$ref": "../schemas/common.json#/responses/403"}
      }
    }
  },
  "refresh": {
    "post": {
      "operationId": "realtimeRefresh",
      "security": [
        {
          "RealtimeProxy": []
        }
      ],
      "description": "Internal Centrifugo proxy. Cookie and Origin carry the original session authority. Subscription choices are selected by the server.",
      "requestBody": {
        "required": false,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "result"
                    ],
                    "properties": {
                      "result": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "expire_at"
                        ],
                        "properties": {
                          "expire_at": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "result"
                    ],
                    "properties": {
                      "result": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "expired"
                        ],
                        "properties": {
                          "expired": {
                            "type": "boolean",
                            "enum": [
                              true
                            ]
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "403": {"$ref": "../schemas/common.json#/responses/403"}
      }
    }
  }
}
