          }
        },
        "409": {"$ref": "../schemas/common.json#/responses/409"},
        "422": {"$ref": "../schemas/common.json#/responses/422"},
        "428": {"$ref": "../schemas/common.json#/responses/428"},
        "503": {"$ref": "../schemas/common.json#/responses/503"}
      }
    }
  },
