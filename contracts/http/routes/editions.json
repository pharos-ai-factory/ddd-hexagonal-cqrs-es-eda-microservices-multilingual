    },
    "post": {
      "operationId": "createEdition",
      "summary": "createEdition",
      "parameters": [
        {"$ref": "../schemas/common.json#/parameters/CommandID"},
        {"$ref": "../schemas/common.json#/parameters/Version"},
        {"$ref": "../schemas/common.json#/parameters/Correlation"}
      ],
      "requestBody": {
        "required": true,
        "description": "One JSON object, at most 64 KiB. Business terms are decided and recorded by the owner.",
        "content": {
          "application/json": {
            "schema": {"$ref": "../schemas/menu.json#/schemas/EditionCommand"},
            "example": {
              "currency": "EUR"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {"$ref": "../schemas/common.json#/schemas/Outcome"},
              "example": {
                "aggregateId": "11111111-1111-4111-8111-111111111111",
                "version": 1,
                "status": "draft"
              }
            }
          }
        },
        "400": {"$ref": "../schemas/common.json#/responses/400"},
        "401": {"$ref": "../schemas/common.json#/responses/401"},
        "403": {"$ref": "../schemas/common.json#/responses/403"},
        "404": {
          "description": "Recorded missing-root rejection",
          "content": {
            "application/json": {
              "schema": {"$ref": "../schemas/common.json#/schemas/RejectedOutcome"}
