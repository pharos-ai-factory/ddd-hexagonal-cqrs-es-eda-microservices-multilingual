{
  "list": {
    "x-owner": "communication",
    "get": {
      "operationId": "listNotifications",
      "summary": "List notifications",
      "parameters": [
        {"$ref": "../../shared/http_api/parameters.json#/parameters/Limit"},
        {"$ref": "../../shared/http_api/parameters.json#/parameters/Cursor"}
      ],
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "exists",
                        "version",
                        "state"
                      ],
                      "properties": {
                        "exists": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        },
                        "version": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "state": {"$ref": "schemas.json#/schemas/Notification"}
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "items",
                      "nextCursor"
                    ],
                    "properties": {
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "exists",
                            "version",
                            "state"
                          ],
                          "properties": {
                            "exists": {
                              "type": "boolean",
                              "enum": [
                                true
                              ]
                            },
                            "version": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "state": {"$ref": "schemas.json#/schemas/Notification"}
                          }
                        }
                      },
                      "nextCursor": {
                        "type": "string",
                        "nullable": true
                      }
                    }
                  }
                ]
              },
              "example": [
                {
                  "exists": true,
                  "version": 1,
                  "state": {
                    "id": "11111111-1111-4111-8111-111111111111",
                    "recipient": "22222222-2222-4222-8222-222222222222",
                    "subject": "Ready",
                    "body": "Coffee is ready",
                    "status": "requested"
                  }
                }
              ]
            }
          }
        },
        "400": {"$ref": "../../shared/http_api/responses.json#/responses/400"},
        "401": {"$ref": "../../shared/http_api/responses.json#/responses/401"},
        "403": {"$ref": "../../shared/http_api/responses.json#/responses/403"},
        "503": {"$ref": "../../shared/http_api/responses.json#/responses/503"}
      }
    }
  },
  "item": {
    "x-owner": "communication",
    "parameters": [
      {"$ref": "../../shared/http_api/parameters.json#/parameters/ID"}
    ],
    "get": {
      "operationId": "getNotification",
      "summary": "Get Notification",
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "exists",
                  "version",
                  "state"
                ],
                "properties": {
                  "exists": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "state": {"$ref": "schemas.json#/schemas/Notification"}
                }
              },
              "example": {
                "exists": true,
                "version": 1,
                "state": {
                  "id": "11111111-1111-4111-8111-111111111111",
                  "recipient": "22222222-2222-4222-8222-222222222222",
                  "subject": "Ready",
                  "body": "Coffee is ready",
                  "status": "requested"
                }
              }
            }
          }
        },
        "400": {"$ref": "../../shared/http_api/responses.json#/responses/400"},
        "401": {"$ref": "../../shared/http_api/responses.json#/responses/401"},
        "403": {"$ref": "../../shared/http_api/responses.json#/responses/403"},
        "404": {"$ref": "../../shared/http_api/responses.json#/responses/404"},
        "503": {"$ref": "../../shared/http_api/responses.json#/responses/503"}
      }
    }
  }
}
