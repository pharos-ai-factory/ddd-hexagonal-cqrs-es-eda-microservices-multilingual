{
  "schemas": {
    "Notification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recipient",
        "subject",
        "body",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "recipient": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "requested",
            "sent"
          ]
        },
        "providerReceipt": {
          "type": "string"
        }
      }
    }
  }
}
