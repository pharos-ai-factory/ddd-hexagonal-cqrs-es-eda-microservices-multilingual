{
  "health": {
    "get": {
      "operationId": "apiHealth",
      "tags": ["operational"],
      "security": [],
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "role"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["ok"]
                  },
                  "role": {
                    "type": "string",
                    "enum": ["client-api"]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "diagnostics": {
    "get": {
      "operationId": "apiDiagnostics",
      "tags": ["operational"],
      "security": [
        {
          "CLIKey": []
        }
      ],
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": { "$ref": "operational.schemas.json#/schemas/SessionDiagnostics" }
            }
          }
        },
        "401": { "$ref": "../../../shared/http_api/responses.json#/responses/401" },
        "503": { "$ref": "../../../shared/http_api/responses.json#/responses/503" }
      }
    }
  }
}
