{
  "schemas": {
    "Grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "accountId",
        "benefit",
        "validDays"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "accountId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "benefit": {
          "type": "string"
        },
        "validDays": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stampBalance",
        "collections",
        "grantsEarned"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "stampBalance": {
          "type": "integer",
          "minimum": 0
        },
        "collections": {
          "type": "integer",
          "minimum": 0
        },
        "grantsEarned": {
          "type": "integer",
          "minimum": 0
        },
        "lastGrant": {"$ref": "#/schemas/Grant"}
      }
    },
    "Reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "grantId",
        "customerId",
        "benefit",
        "status",
        "expiresAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "grantId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "customerId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "benefit": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "issued",
            "redeemed",
            "expired"
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "redeemedFor": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "RedeemCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    }
  }
}
