{
  "schemas": {
    "Ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "orderId",
        "customerId",
        "instructions",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "orderId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "customerId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "instructions": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "preparing",
            "ready"
          ]
        }
      }
    }
  }
}
