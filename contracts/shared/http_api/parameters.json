{
  "parameters": {
    "ID": {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "example": "11111111-1111-4111-8111-111111111111"
    },
    "CommandID": {
      "name": "Idempotency-Key",
      "in": "header",
      "required": true,
      "schema": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "example": "22222222-2222-4222-8222-222222222222"
    },
    "Version": {
      "name": "If-Match",
      "in": "header",
      "required": true,
      "description": "Expected root version; 0 creates a root. Quoted decimal versions are also accepted. Invalid or missing values return 428.",
      "schema": {
        "type": "string",
        "pattern": "^\"?[0-9]+\"?$"
      },
      "example": "0"
    },
    "Correlation": {
      "name": "X-Correlation-ID",
      "in": "header",
      "required": false,
      "schema": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "Limit": {
      "name": "limit",
      "in": "query",
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "Cursor": {
      "name": "cursor",
      "in": "query",
      "description": "Opaque, resource-bound cursor. Requires limit. Repeated pagination parameters are rejected.",
      "schema": {
        "type": "string",
        "maxLength": 1024
      }
    }
  }
}
