{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
  "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
  "[go]": { "editor.defaultFormatter": "golang.go" },
  "[typescript][typescriptreact][javascript][json][jsonc][yaml][markdown][css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "python.defaultInterpreterPath": "${workspaceFolder}/services/operations/.venv/bin/python",
  "ruff.path": ["${workspaceFolder}/services/operations/.venv/bin/ruff"],
  "mypy-type-checker.cwd": "${workspaceFolder}/services/operations",
  "mypy-type-checker.path": ["${workspaceFolder}/services/operations/.venv/bin/mypy"],
  "mypy-type-checker.args": ["--config-file", "${workspaceFolder}/services/operations/pyproject.toml"],
  "eslint.workingDirectories": ["."],
  "gopls": { "staticcheck": true }
}
