{
  "openapi": "3.0.3",
  "info": {
    "title": "Café Go development notification provider",
    "version": "1.0.0",
    "description": "Development-only HTTP contract. This document is authoritative for route registration and wire conformance."
  },
  "paths": {
    "/messages": {
      "get": {
        "operationId": "listAcceptedMessages",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "receipt",
                      "fingerprint",
                      "message"
                    ],
                    "properties": {
                      "receipt": {
                        "type": "string"
                      },
                      "fingerprint": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "message": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "recipient",
                          "subject",
                          "body"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                          },
                          "recipient": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                          },
                          "subject": {
                            "type": "string"
                          },
                          "body": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/shared.http_api.responses.401"
          },
          "500": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/shared.http_api.schemas.Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "acceptMessage",
        "parameters": [
          {
            "$ref": "#/components/parameters/shared.http_api.parameters.CommandID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "recipient",
                  "subject",
                  "body"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "recipient": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "id": "11111111-1111-4111-8111-111111111111",
                "recipient": "22222222-2222-4222-8222-222222222222",
                "subject": "Ready",
                "body": "Coffee"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "receipt",
                    "fingerprint",
                    "message"
                  ],
                  "properties": {
                    "receipt": {
                      "type": "string"
                    },
                    "fingerprint": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "message": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "recipient",
                        "subject",
                        "body"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                        },
                        "recipient": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                        },
                        "subject": {
                          "type": "string"
                        },
                        "body": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/shared.http_api.responses.400"
          },
          "401": {
            "$ref": "#/components/responses/shared.http_api.responses.401"
          },
          "503": {
            "$ref": "#/components/responses/shared.http_api.responses.503"
          },
          "409": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/shared.http_api.schemas.Error"
                }
              }
            }
          },
          "500": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/shared.http_api.schemas.Error"
                }
              }
            }
          }
        }
      }
    },
    "/failures": {
      "post": {
        "operationId": "configureProviderFailure",
        "description": "Development fixture only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "count",
                  "lostResponses"
                ],
                "properties": {
                  "count": {
                    "type": "integer"
                  },
                  "lostResponses": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "count",
                    "lostResponses"
                  ],
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "lostResponses": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/shared.http_api.responses.400"
          },
          "401": {
            "$ref": "#/components/responses/shared.http_api.responses.401"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ServiceKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "shared.http_api.schemas.Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "shared.http_api.responses.401": {
        "description": "Missing or invalid credentials",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/shared.http_api.schemas.Error"
            }
          }
        }
      },
      "shared.http_api.responses.400": {
        "description": "Malformed request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/shared.http_api.schemas.Error"
            }
          }
        }
      },
      "shared.http_api.responses.503": {
        "description": "Infrastructure unavailable; retry the same identity",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/shared.http_api.schemas.Error"
            }
          }
        }
      }
    },
    "parameters": {
      "shared.http_api.parameters.CommandID": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "example": "22222222-2222-4222-8222-222222222222"
      }
    }
  },
  "security": [
    {
      "ServiceKey": []
    }
  ]
}
