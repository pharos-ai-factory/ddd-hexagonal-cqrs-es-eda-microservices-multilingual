{
  "openapi": "3.0.3",
  "info": {
    "title": "Café Go Storefront",
    "version": "1.0.0",
    "description": "Development-only operational HTTP contract. Business commands and queries enter through RabbitMQ; their public HTTP boundary is the Go API."
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "storefrontHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/diagnostics": {
      "get": {
        "operationId": "storefrontDiagnostics",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/services.storefront.http_api.operational.schemas.StorefrontDiagnostics"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/shared.http_api.responses.401"
          },
          "503": {
            "$ref": "#/components/responses/shared.http_api.responses.503"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ServiceKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "services.storefront.http_api.operational.schemas.StorefrontDiagnostics": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "databases",
          "processWorkers",
          "counterScope"
        ],
        "properties": {
          "databases": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outbox",
                "realtime"
              ],
              "properties": {
                "outbox": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "pending",
                    "oldestAgeSeconds",
                    "failed"
                  ],
                  "properties": {
                    "pending": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "oldestAgeSeconds": {
                      "type": "number"
                    },
                    "failed": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "realtime": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "pending",
                    "oldestAgeSeconds",
                    "failed"
                  ],
                  "properties": {
                    "pending": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "oldestAgeSeconds": {
                      "type": "number"
                    },
                    "failed": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "processWorkers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "owner",
                "name",
                "failures",
                "deadLetterTransfers",
                "lastFailure"
              ],
              "properties": {
                "owner": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "failures": {
                  "type": "integer",
                  "minimum": 0
                },
                "deadLetterTransfers": {
                  "type": "integer",
                  "minimum": 0
                },
                "lastFailure": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "at",
                    "class"
                  ],
                  "properties": {
                    "at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "class": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "correlation": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "counterScope": {
            "type": "string"
          }
        }
      },
      "shared.http_api.schemas.Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "shared.http_api.responses.401": {
        "description": "Missing or invalid credentials",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/shared.http_api.schemas.Error"
            }
          }
        }
      },
      "shared.http_api.responses.503": {
        "description": "Infrastructure unavailable; retry the same identity",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/shared.http_api.schemas.Error"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "ServiceKey": []
    }
  ]
}
