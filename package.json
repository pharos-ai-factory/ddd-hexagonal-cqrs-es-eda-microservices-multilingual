{
  "name": "cafe-ddd-reference",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@cucumber/gherkin": "42.0.0",
    "@cucumber/messages": "34.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@rsbuild/core": "2.2.13",
    "@rspress/core": "2.0.23",
    "@types/amqplib": "0.10.8",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "amqplib": "2.0.1",
    "eslint": "10.12.0",
    "orval": "8.44.0",
    "pg": "8.23.0",
    "prettier": "3.6.2",
    "protobufjs": "8.8.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "rspress-plugin-mermaid": "1.0.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "scripts": {
    "docs:dev": "rspress dev",
    "docs:build": "rspress build",
    "docs:preview": "rspress preview",
    "docs:check": "tsc --project scripts/docs/tsconfig.json && eslint --max-warnings=0 rspress.config.ts scripts/docs && node --import tsx --test scripts/docs/*.test.ts && pnpm docs:build && node --import tsx scripts/docs/check-build.ts",
    "verify": "python3 scripts/verify.py",
    "test:unit": "python3 scripts/developer.py test",
    "test:bdd": "python3 scripts/bdd.py",
    "check:specifications": "node scripts/check_specifications.mjs",
    "test:integration": "python3 scripts/integration.py",
    "dev:configure": "python3 scripts/dev.py configure",
    "dev:up": "python3 scripts/dev.py up",
    "dev:down": "python3 scripts/dev.py down",
    "dev:logs": "python3 scripts/dev.py logs",
    "demo": "python3 scripts/journey.py",
    "events:replay": "python3 scripts/replay.py",
    "check:architecture": "python3 scripts/check_architecture.py",
    "check:large-file-review": "python3 scripts/check_architecture.py",
    "generate:http": "python3 scripts/http_contracts.py",
    "check:http": "python3 scripts/http_contracts.py --check",
    "generate:contracts": "python3 scripts/generate.py",
    "test:browser": "python3 scripts/browser.py",
    "check:contracts": "python3 scripts/check_contracts.py",
    "test:focused": "python3 scripts/developer.py test",
    "dev:doctor": "python3 scripts/developer.py doctor",
    "dev:watch": "python3 scripts/developer.py watch",
    "dev:status": "python3 scripts/readiness.py",
    "check:compatibility": "uv run --no-project --with grpcio-tools==1.84.0 python scripts/compatibility.py",
    "workflow:inspect": "python3 scripts/inspect_workflow.py",
    "scaffold": "python3 scripts/scaffold.py",
    "format": "python3 scripts/format.py",
    "format:check": "python3 scripts/format.py --check",
    "context": "python3 scripts/context_catalogue.py",
    "check": "python3 scripts/check.py",
    "check:watch": "python3 scripts/check.py --watch"
  }
}
